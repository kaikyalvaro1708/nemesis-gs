# =============================================================================
# NEMESIS — .gitignore
# =============================================================================

# Terraform — arquivos gerados localmente (NUNCA commitar)
infra/terraform.tfvars
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/tfplan
infra/*.tfplan
infra/crash.log
infra/override.tf
infra/override.tf.json
infra/*_override.tf
infra/*_override.tf.json

# Segredos e variáveis de ambiente
.env
.env.*
*.pem
*.key
azure.txt

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Node (caso utilizado localmente)
node_modules/
npm-debug.log*
